<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.15" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\TimeLens.Domain\Protos\ingestion.proto" GrpcServices="Server" Link="Protos\ingestion.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeLens.Domain\TimeLens.Domain.csproj" />
    <ProjectReference Include="..\TimeLens.Infrastructure\TimeLens.Infrastructure.csproj" />
  </ItemGroup>

</Project>
