{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=timelens;Username=timelens"
  },
  "Coinbase": {
    "BaseUrl": "https://api.exchange.coinbase.com/"
  },
  "EnergyCharts": {
    "BaseUrl": "https://api.energy-charts.info/"
  },
  "CoinMetrics": {
    "BaseUrl": "https://community-api.coinmetrics.io/v4/"
  },
  "InsertApi": {
    "GrpcUrl": "http://localhost:5103",
    "TokenEndpoint": "",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "timelens.insert.write"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "timelens",
    "UserName": "guest",
    "Password": "",
    "ExchangeName": "timelens.jobs",
    "QueueName": "timelens.ingestion.jobs"
  },
  "Ingestion": {
    "LookbackHours": 48,
    "BatchSize": 500,
    "MinRequestIntervalSeconds": 3,
    "MaxProviderRetries": 3,
    "RetryBaseDelaySeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http": "Warning",
      "Microsoft.Extensions.Http": "Warning"
    }
  },
  "Observability": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "SamplingRatio": 1.0
  }
}
